# Copiar como .env.development.local y completar. Ver tambien ../.env.example
# (backend). IMPORTANTE: no usar .env.local — Next.js lo carga incluso en
# `next build` (produccion) y pisa los valores de .env.production, lo que
# manda el sitio desplegado a llamar a localhost (ver memoria de sesion:
# srp-reservas-env-local-precedence).

# URL base de la API del backend (src/server.ts), incluyendo /api.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Numero SINPE real de Sarapiqui Race Park para recibir depositos (6.9).
# PLACEHOLDER: reemplazar por el numero real antes de usar en produccion.
NEXT_PUBLIC_SINPE_PHONE=0000-0000
