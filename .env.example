# Copiar este archivo como .env y completar los valores reales.
# .env nunca debe subirse al repositorio (ver .gitignore).

# Proyecto Supabase "SRP reservas" (plan free). Ambas cadenas se obtienen en
# Project Settings -> Database -> Connection string.
#
# DATABASE_URL: pooler de Supabase en modo Transaction (puerto 6543). La usa
# la app en runtime (Prisma Client). Requiere "?pgbouncer=true" al final.
DATABASE_URL="postgresql://usuario:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: conexion directa a Postgres (puerto 5432), sin pooler. La usan
# `prisma migrate` / `prisma db push` porque necesitan sesiones persistentes
# que el pooler en modo transaccion no soporta de forma confiable.
DIRECT_URL="postgresql://usuario:password@db.proyecto.supabase.co:5432/postgres"

# Puerto donde escuchara el servidor Express.
PORT=3000

# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Zona horaria operativa del negocio (Costa Rica).
TZ=America/Costa_Rica

# Cada cuantos milisegundos el servidor revisa y libera reservas TEMPORAL
# vencidas (19.1, src/worker/expiracion-worker.ts). Opcional, default 60000
# (1 minuto).
EXPIRACION_INTERVALO_MS=60000

# Origen (protocolo+dominio+puerto) de la app de reservas (web/, Next.js),
# para el middleware CORS de esta API. Opcional en desarrollo (default
# http://localhost:3001); obligatorio en produccion.
WEB_APP_URL=http://localhost:3001

# Secreto para firmar los JWT del panel administrativo (14.7, 20.1). Generar
# uno propio y unico por entorno, ej.: openssl rand -hex 32
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Si al arrancar el servidor no existe ningun usuario administrativo, se crea
# uno con estas credenciales (ver asegurarAdminInicial en auth.service.ts).
# Sin efecto una vez que ya existe al menos un usuario.
ADMIN_EMAIL="admin@sarapiquiracepark.example"
ADMIN_PASSWORD="cambiar-esta-contrasena"
