# Copiar este archivo como .env y completar los valores reales.
# .env nunca debe subirse al repositorio (ver .gitignore).

# Proyecto Supabase "SRP reservas" (plan free). Ambas cadenas se obtienen en
# Project Settings -> Database -> Connection string.
#
# DATABASE_URL: pooler de Supabase en modo Transaction (puerto 6543). La usa
# la app en runtime (Prisma Client). Requiere "?pgbouncer=true" al final.
DATABASE_URL="postgresql://usuario:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: conexion directa a Postgres (puerto 5432), sin pooler. La usan
# `prisma migrate` / `prisma db push` porque necesitan sesiones persistentes
# que el pooler en modo transaccion no soporta de forma confiable.
DIRECT_URL="postgresql://usuario:password@db.proyecto.supabase.co:5432/postgres"

# Puerto donde escuchara el servidor Express.
PORT=3000

# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Zona horaria operativa del negocio (Costa Rica).
TZ=America/Costa_Rica
